{
  "manifest_version": 3,
  "name": "Page Counter",
  "default_locale": "en",
  "version": "1.0.0",
  "description": "__MSG_ext_description__",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page Counter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "increment-primary": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "__MSG_cmd_increment__"
    },
    "decrement-primary": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "__MSG_cmd_decrement__"
    },
    "reset-primary": {
      "suggested_key": {
        "default": "Alt+0"
      },
      "description": "__MSG_cmd_reset__"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
